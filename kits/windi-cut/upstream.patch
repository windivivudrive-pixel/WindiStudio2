+"use client";
+import {useState} from "react";
+import {useRouter} from "next/navigation";
+import {EditorCore} from "@/core";
+import {processMediaAssets} from "@/media/processing";
+import {initializeGpuRenderer} from "@/services/renderer/gpu-renderer";
+import {mediaTimeFromSeconds,ZERO_MEDIA_TIME} from "@/wasm";
+import {DEFAULTS} from "@/timeline/defaults";
+import type {TimelineElement, OverlayTrack} from "@/timeline";
+import type {ParamValues} from "@/params";
+
+type Item = {name:string;type:"text"|"graphic"|"video"|"audio";start:number;duration:number;params:ParamValues;definitionId?:string;asset?:string};
+type Manifest = {episodeId:string;duration:number;layers:{name:string;type:"text"|"graphic"|"video"|"audio";items:Item[]}[];assets:{name:string;url:string}[]};
+export default function WindiLab() {
+  const router=useRouter(), [busy,setBusy]=useState(false), [status,setStatus]=useState("");
+  async function open(mode:"episode"|"qa"|"blank") {
+    if(busy)return;setBusy(true);
+    let paused=false;
+    try {
+      const storageKey="windi-cut:"+mode;
+      const existing=localStorage.getItem(storageKey);
+      if(existing){router.push("/editor/"+existing);return;}
+      setStatus("Khởi tạo OpenCut…"); await initializeGpuRenderer();
+      await document.fonts.load("400 16px Calling"); await document.fonts.load("700 16px Calling");
+      const editor=EditorCore.getInstance();
+      const projectId=await editor.project.createNewProject({name:mode==="blank"?"Windi · Bản dựng mới":mode==="qa"?"Windi · Mẫu QA 3 giây":"WS25 · Windi nhiều layer"});
+      await editor.project.loadProject({id:projectId});
+      editor.save.pause();
+      paused=true;
+      await editor.project.updateSettings({settings:{canvasSize:{width:1080,height:1920},fps:{numerator:30,denominator:1},background:{type:"color",color:"#cfe7fa"}},pushHistory:false});
+      if(mode!=="blank") {
+        const response=await fetch("/windi-media/manifest.json");
+        if(!response.ok)throw new Error("Chưa chuẩn bị tập WS25. Chạy npm run video:cut:prepare.");
+        const manifest:Manifest=await response.json();
+        const assets=new Map<string,string>();
+        const required=mode==="qa"?manifest.assets.filter(a=>a.name==="voice.mp3" || a.name==="clip_beat1.mp4"):manifest.assets;
+        for(const source of required) {
+          setStatus("Nạp "+source.name+"…");
+          const response=await fetch(source.url);
+          if(!response.ok)throw new Error("Không tải được "+source.name);
+          const blob=await response.blob(),file=new File([blob],source.name,{type:blob.type});
+          const processed=await processMediaAssets({files:[file]});
+          if(!processed[0])throw new Error("Không đọc được "+source.name);
+          const asset=await editor.media.addMediaAsset({projectId,asset:processed[0]});
+          if(!asset)throw new Error("Không lưu được media");
+          assets.set(source.name,asset.id);
+        }
+        const full=editor.scenes.getActiveScene().tracks, overlay:OverlayTrack[]=[], audio=full.audio.slice();
+        for(const layer of manifest.layers) {
+          const items=layer.items.filter(item=>mode!=="qa" || item.start<3);
+          const elements:TimelineElement[]=items.flatMap<TimelineElement>(item=>{
+            if(item.asset&&!assets.has(item.asset))return [];
+            const duration=mode==="qa"?Math.min(item.duration,3-item.start):item.duration;
+            const params=item.type==="text"?{...DEFAULTS.text.element.params,...item.params}:item.params;
+            const common={id:crypto.randomUUID(),name:item.name,type:item.type,duration:mediaTimeFromSeconds({seconds:duration}),startTime:mediaTimeFromSeconds({seconds:item.start}),trimStart:ZERO_MEDIA_TIME,trimEnd:ZERO_MEDIA_TIME,params};
+            if(item.type==="video")return [{...common,type:"video",mediaId:assets.get(item.asset!)!,isSourceAudioEnabled:false}];
+            if(item.type==="audio")return [{...common,type:"audio",sourceType:"upload",mediaId:assets.get(item.asset!)!}];
+            if(item.type==="graphic")return [{...common,type:"graphic",definitionId:item.definitionId || "rectangle"}];
+            return [{...common,type:"text"}];
+          });
+          if(!elements.length)continue;
+          const track={id:crypto.randomUUID(),name:layer.name,type:layer.type,elements,hidden:false,muted:false};
+          if(layer.type==="audio")audio.push(track as typeof audio[number]);else overlay.push(track as OverlayTrack);
+        }
+        editor.timeline.updateTracks({...full,overlay,audio});
+      }
+      editor.save.resume();paused=false;await editor.save.flush();
+      localStorage.setItem(storageKey,projectId);router.push("/editor/"+projectId);
+    } catch(error){setStatus(error instanceof Error?error.message:"Chưa mở được editor");setBusy(false);}
+    finally{if(paused)EditorCore.getInstance().save.resume();}
+  }
+  return <main className="windi-home">
+    <div className="windi-home-header"><span className="windi-wordmark">windi<span>/cut</span></span><span className="windi-lab">LOCAL LAB · 02</span></div>
+    <small>RETRO WORKSPACE / POWERED BY OPENCUT CLASSIC</small>
+    <h1>Mỗi thành phần.<br/>Một layer để chỉnh.</h1>
+    <p>Chọn chữ, hình, khung, caption hay watermark ngay trên canvas. Di chuyển, đổi kích thước, xoay, chỉnh màu và keyframe. Timeline không khóa ở 4 track; thêm layer theo bản dựng của bạn.</p>
+    <div className="windi-home-actions"><button disabled={busy} onClick={()=>open("episode")}>Mở WS25 nhiều layer</button><button disabled={busy} onClick={()=>open("blank")}>Bản dựng trống</button><button disabled={busy} onClick={()=>open("qa")}>Mẫu QA 3 giây</button></div>
+    <p role="status">{status}</p>
+    <div className="windi-note"><strong>Preview trước. Bấm xuất mới render.</strong><p>Bản thử riêng, không ghi đè video/source gốc. Draft tự lưu trong trình duyệt này; “Lưu + backup” tải JSON cấu trúc để giữ một bản ngoài trình duyệt.</p><small>WS25 được dựng lại bằng đối tượng OpenCut có thể chỉnh, không phải import MP4 phẳng. Animation/3D Remotion và karaoke từng từ chưa được chuyển tự động. Chưa tích hợp web thương mại.</small><small>OpenCut Classic · MIT · <a href="https://github.com/OpenCut-app/opencut-classic" target="_blank" rel="noreferrer">Mã nguồn upstream</a></small></div>
+  </main>;
+}
diff --git a/apps/web/src/components/editor/windi-layers.tsx b/apps/web/src/components/editor/windi-layers.tsx
new file mode 100644
index 0000000..1d28253
--- /dev/null
+++ b/apps/web/src/components/editor/windi-layers.tsx
@@ -0,0 +1,36 @@
+"use client";
+import {useEditor} from "@/editor/use-editor";
+import {DEFAULTS} from "@/timeline/defaults";
+import {mediaTimeFromSeconds} from "@/wasm";
+import {Eye,EyeOff,Square,Type,Film} from "lucide-react";
+export function WindiLayers() {
+  const editor=useEditor(), scene=useEditor(e=>e.scenes.getActiveSceneOrNull());
+  const selection=useEditor(e=>e.selection.getSelectedElements());
+  if(!scene)return null;
+  const tracks=[...scene.tracks.overlay,scene.tracks.main,...scene.tracks.audio];
+  function add(kind:"text"|"graphic"|"video") {
+    const startTime=editor.playback.getCurrentTime(), duration=mediaTimeFromSeconds({seconds:3});
+    const placement={mode:"auto" as const,trackType:kind,insertIndex:0};
+    if(kind==="text")editor.timeline.insertElement({placement,element:{...DEFAULTS.text.element,name:"Chữ mới",startTime,duration,params:{...DEFAULTS.text.element.params,content:"CHỮ MỚI",fontFamily:"Calling",fontSize:3,color:"#28332f"}}});
+    if(kind==="graphic")editor.timeline.insertElement({placement,element:{type:"graphic",definitionId:"rectangle",name:"Khung mới",startTime,duration,trimStart:DEFAULTS.text.element.trimStart,trimEnd:DEFAULTS.text.element.trimEnd,params:{fill:"#fff9ea",stroke:"#32483e",strokeWidth:3,"transform.scaleX":0.5,"transform.scaleY":0.3,opacity:1}}});
+    if(kind==="video") {
+      const asset=editor.media.getAssets().find(a=>a.type==="video" || a.type==="image");
+      if(asset)editor.timeline.insertElement({placement,element:{type:asset.type as "video",mediaId:asset.id,name:asset.name,startTime,duration:mediaTimeFromSeconds({seconds:Math.min(3,asset.duration||3)}),trimStart:DEFAULTS.text.element.trimStart,trimEnd:DEFAULTS.text.element.trimEnd,params:{volume:0,opacity:1,"transform.scaleX":0.3,"transform.scaleY":0.3}}});
+    }
+  }
+  return <section className="windi-layers" aria-label="Layer của bản dựng">
+    <h3><strong>ĐỐI TƯỢNG / LAYER</strong><span>{tracks.length} track</span></h3>
+    <div className="windi-layer-tools"><button onClick={()=>add("text")}><Type size={11}/> + Chữ</button><button onClick={()=>add("graphic")}><Square size={11}/> + Khung</button><button onClick={()=>add("video")}><Film size={11}/> + Media</button></div>
+    {tracks.map(track=><div className="windi-layer-row" key={track.id}>
+      <button aria-label={"Chọn layer "+track.name} aria-pressed={selection.some(s=>s.trackId===track.id)} onClick={()=>{
+        const time=editor.playback.getCurrentTime(), element=track.elements.find(e=>e.startTime<=time && e.startTime+e.duration>time) || track.elements[0];
+        if(element){editor.selection.setSelectedElements({elements:[{trackId:track.id,elementId:element.id}]});editor.playback.seek({time:element.startTime});}
+      }}>{track.type.toUpperCase()} · {track.name}</button>
+      {"hidden" in track && <button aria-label={(track.hidden?"Hiện":"Ẩn")+" layer "+track.name} onClick={()=>editor.timeline.toggleTrackVisibility({trackId:track.id})}>{track.hidden?<EyeOff size={12}/>:<Eye size={12}/>}</button>}
+      {track.elements.length>1 && selection.some(s=>s.trackId===track.id) && <select style={{gridColumn:"1 / -1",width:"100%",fontSize:11}} aria-label={"Đối tượng trong layer "+track.name} value={selection.find(s=>s.trackId===track.id)?.elementId || ""} onChange={event=>{
+        const element=track.elements.find(e=>e.id===event.target.value);
+        if(element){editor.selection.setSelectedElements({elements:[{trackId:track.id,elementId:element.id}]});editor.playback.seek({time:element.startTime});}
+      }}>{track.elements.map((element,index)=><option key={element.id} value={element.id}>{index+1} · {typeof element.params.content==="string"?element.params.content.replace(/\s+/g," ").slice(0,60):element.name}</option>)}</select>}
+    </div>)}
+  </section>;
+}
diff --git a/apps/web/src/export/tiktok.ts b/apps/web/src/export/tiktok.ts
new file mode 100644
index 0000000..80c314d
--- /dev/null
+++ b/apps/web/src/export/tiktok.ts
@@ -0,0 +1,19 @@
+import {canEncodeVideo, type VideoEncodingConfig} from "mediabunny";
+
+// A Windi delivery choice, not a TikTok-mandated bitrate. Keep fine captions
+// at 1080p while avoiding the upstream subjective high-quality bitrate.
+export const TIKTOK_VIDEO_BITRATE = 6_000_000;
+export const TIKTOK_AUDIO_BITRATE = 128_000;
+export const TIKTOK_FPS = {numerator:30, denominator:1};
+
+export async function resolveTikTokEncoding({width,height}:{width:number;height:number}):Promise<VideoEncodingConfig> {
+  if(width!==1080 || height!==1920)throw new Error("Preset TikTok cần canvas 1080 × 1920. Đổi kích thước trong Settings hoặc chọn xuất tùy chỉnh.");
+  const base:VideoEncodingConfig={codec:"avc",fullCodecString:"avc1.640028",bitrate:TIKTOK_VIDEO_BITRATE,bitrateMode:"variable",latencyMode:"quality",keyFrameInterval:2};
+  for(const hardwareAcceleration of ["prefer-hardware","no-preference"] as const){
+    if(await canEncodeVideo("avc",{width,height,...base,hardwareAcceleration})){
+      console.info("[Windi export] H.264 encoder preference:",hardwareAcceleration,"6 Mbps / 1080p30");
+      return {...base,hardwareAcceleration};
+    }
+  }
+  throw new Error("Trình duyệt chưa hỗ trợ cấu hình H.264 này. Hãy mở editor bằng Chrome hoặc Safari mới nhất, hoặc chọn xuất tùy chỉnh.");
+}
