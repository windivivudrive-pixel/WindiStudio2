+"use client";
+import {useState} from "react";
+import {useEditor} from "@/editor/use-editor";
+import {ExportButton} from "./export-button";
+import {Button} from "../ui/button";
+import {Undo2,Redo2,Save,Layers3} from "lucide-react";
+import Link from "next/link";
+export function EditorHeader() {
+  const editor=useEditor();
+  const project=useEditor(e=>e.project.getActiveOrNull());
+  const scene=useEditor(e=>e.scenes.getActiveSceneOrNull());
+  const [notice,setNotice]=useState("");
+  const count=scene ? scene.tracks.overlay.length+scene.tracks.audio.length+1 : 0;
+  async function backup() {
+    try {await editor.save.flush(); const p=editor.project.getActive(); const blob=new Blob([JSON.stringify({...p,scenes:editor.scenes.getScenes()},null,2)],{type:"application/json"});
+      const url=URL.createObjectURL(blob), a=document.createElement("a"); a.href=url; a.download=p.metadata.name+".windicut.json"; a.click(); URL.revokeObjectURL(url); setNotice("Đã lưu + tải backup JSON");}
+    catch(e){setNotice(e instanceof Error?e.message:"Chưa lưu được");}
+  }
+  return <header className="windi-titlebar">
+    <Link href="/windi" className="windi-wordmark">windi<span>/cut</span></Link>
+    <span className="windi-lab">LOCAL LAB</span>
+    <div className="windi-project"><strong>{project?.metadata.name}</strong><small><Layers3 size={12}/>{count} layer · 9:16 · OpenCut Classic</small></div>
+    <span className="windi-save-state" role="status">{notice || "Tự lưu trong trình duyệt · chưa render"}</span>
+    <Button variant="outline" size="icon" aria-label="Hoàn tác" onClick={()=>editor.command.undo()}><Undo2/></Button>
+    <Button variant="outline" size="icon" aria-label="Làm lại" onClick={()=>editor.command.redo()}><Redo2/></Button>
+    <Button variant="outline" onClick={backup}><Save/>Lưu + backup</Button>
+    <ExportButton/>
+  </header>;
+}
