# Public Supabase values used by the browser. Keep the service-role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only integrations
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
SKILLS_SH_API_KEY=
MCP_REGISTRY_API_KEY=
SEPAY_API_KEY=

# Existing deployment names are supported during migration from Vite.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Voice Studio (server-only). API key from your Cartesia workspace.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_SPEED=1.15
# Configure the actual receiving account and the SePay webhook before enabling sales.
VOICE_BANK_BIN=
VOICE_BANK_ACCOUNT=
VOICE_BANK_NAME=
# SePay endpoint: https://your-domain/api/voice/payment-webhook
# Authentication: Apikey <SEPAY_API_KEY>; incoming transfers to VOICE_BANK_ACCOUNT only.
